<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_regles"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/titre_regles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:text="@string/regles_jeu"
        android:textColor="#EEEEEE"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/titre_principe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/principe_chuzzle"
        android:textColor="#EEEEEE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/texte_principe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/chuzzle_description"
        android:textColor="#EEEEEE"
        android:textSize="16sp" />

    <Button
        android:id="@+id/bouton_retour_regles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:text="@string/compris" />

</LinearLayout>