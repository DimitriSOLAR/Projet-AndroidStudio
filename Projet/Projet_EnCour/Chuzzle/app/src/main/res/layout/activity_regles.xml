<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/titre_regles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:text="Règles du jeu"
        android:textColor="#EEEEEE"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/titre_principe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Principe de Chuzzle :"
        android:textColor="#EEEEEE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/texte_principe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Faites glisser les lignes ou les colonnes pour aligner au moins 3 éléments de la même couleur.\n\nAttention : un mouvement n'est permis que s'il crée une série, sinon la grille revient à son état d'origine !"
        android:textColor="#EEEEEE"
        android:textSize="16sp" />

    <Button
        android:id="@+id/bouton_retour_regles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:text="Compris ?" />

</LinearLayout>